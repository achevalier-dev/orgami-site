---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Command from "../components/Command.astro";
import Demo from "../components/Demo.astro";
import Plate from "../components/Plate.astro";
import Fold from "../components/Fold.astro";
import Kind from "../components/Kind.astro";

const install =
  "curl -fsSL https://raw.githubusercontent.com/achevalier-dev/orgami/main/bootstrap.sh | bash";

const keys: [string, string][] = [
  ["tab", "Move between the map, the repositories, the notes and the recaps"],
  ["type", "Filter the list"],
  ["enter", "Print what is under the cursor into your scrollback, to copy or pipe"],
  ["ctrl-o", "Open the repository on GitHub"],
  ["ctrl-n", "Write a note against the repository you are reading"],
];

const makes: { name: string; colour: string; body: string }[] = [
  {
    name: "The map",
    colour: "var(--k-repo)",
    body: "Deploy tooling, servers, backing services, frameworks, run and test commands, routes, and which repositories reference which. One graph.json; the architecture doc, the diagrams and the terminal browser all render from it.",
  },
  {
    name: "The weekly recap",
    colour: "var(--k-host)",
    body: "Every pull request the organization merged, grouped by why it happened rather than by repository, with a section on how the team worked — review concentration, cycle time, how much merged with nobody else reading it.",
  },
  {
    name: "The daily digest",
    colour: "var(--k-tool)",
    body: "What merged, what opened, what is waiting on someone, and commits with no pull request behind them — the half a merge-based recap cannot see. A quiet day writes no file at all.",
  },
  {
    name: "Team notes",
    colour: "var(--k-service)",
    body: "The cause someone found at 2am, the reason the obvious fix does not work. Screened for credentials and for any other client on the machine before they are written, and again before they are pushed.",
  },
];
---

<Base
  title="orgami"
  description="Map every repository a GitHub organization has, recap what it merges, and hand all of it to your coding agent before you type."
>
  <!-- ── the sheet, folding once ───────────────────────────────────────── -->
  <header class="mx-auto max-w-[1180px] px-6 pt-12 pb-4 md:px-10 lg:pt-20">
    <div class="mb-10 flex items-baseline justify-between gap-6">
      <p class="font-mono text-[12px] tracking-[0.3em] text-ink uppercase">orgami</p>
      <nav class="flex flex-wrap gap-x-6 gap-y-1 font-mono text-[11.5px] text-ink-faint">
        <a href="#evidence" class="no-underline hover:text-vermilion">evidence</a>
        <a href="#makes" class="no-underline hover:text-vermilion">what it makes</a>
        <a href="#screen" class="no-underline hover:text-vermilion">one screen</a>
        <a href="#install" class="no-underline hover:text-vermilion">install</a>
        <a
          href="https://github.com/achevalier-dev/orgami"
          class="no-underline hover:text-vermilion">github ↗</a
        >
      </nav>
    </div>

    <div class="grid items-end gap-x-12 gap-y-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <h1
          class="mb-7 text-[clamp(44px,8.4vw,104px)] leading-[0.92] font-semibold tracking-[-0.035em]"
        >
          Know the<br />organization<br />
          <span class="text-vermilion">before</span> you<br />touch its code.
        </h1>

        <p class="lede max-w-[46ch]">
          A flat sheet of repositories, folded into a shape you can see — then handed to your
          coding agent before you type anything.
        </p>
      </div>

      <div class="lg:pb-3">
        <Fold />
        <p class="mt-5 max-w-[42ch] text-[17px] text-ink-soft">
          orgami reads what a GitHub organization has committed — what each repository is, how to
          run it, what it talks to, where it deploys — recaps what merged each week, digests each
          day, and keeps the whole thing in plain files that diff in git.
        </p>
      </div>
    </div>

    <div class="mt-11 grid max-w-[860px] gap-4">
      <Command command={install} />
      <p class="flex flex-wrap gap-x-7 gap-y-1 font-mono text-[11.5px] text-ink-faint">
        <span>MIT</span>
        <span>macOS · Linux · WSL · Windows</span>
        <span>bash, gh, jq, fzf, gum</span>
        <span>two model calls a week</span>
      </p>
    </div>

    <Demo caption="Recorded against the public honojs organization. Every line came out of a committed file." />
  </header>

  <div class="crease"></div>

  <!-- ── 01 evidence ───────────────────────────────────────────────────── -->
  <Section
    id="evidence"
    folio="01 — evidence"
    title="Nothing in it is a guess."
    note="lib/scan.sh — an edge is emitted with the file it was read from, or it is not emitted."
  >
    <p class="mb-6 max-w-[62ch]">
      The scan reads what is committed. Nothing is inferred by a model, and every edge in the map
      carries the <span class="font-mono text-[0.86em]">file:line</span> it came from, so any claim
      can be opened and checked.
    </p>
    <p class="max-w-[62ch]">
      When the scan cannot see something it says so rather than inventing it. A missing edge means{" "}
      <em class="text-vermilion not-italic">not found in committed configuration</em> — never{" "}
      <em class="not-italic">not connected</em>.
    </p>

    <Plate caption="orgami query gum — one node, and both directions of every edge that named it.">
      <pre><span class="a">▪ gum</span>  <span class="c">repo</span>

  <span class="c">language     </span>Go
  <span class="c">description  </span>A tool for glamorous shell scripts

<span class="c">REFERENCES</span>
  bubbletea                     <span class="c">write/write.go:18</span>
  glamour                       <span class="c">go.mod:11</span>
  lipgloss                      <span class="c">write/write.go:19</span>

<span class="c">USES</span>
  <span class="t">docker</span>                        <span class="c">Dockerfile</span>
  <span class="t">github-actions</span>                <span class="c">.github/workflows</span>

<span class="c">REFERENCED BY</span>
  vhs                           <span class="c">examples/README.md:5</span>
  homebrew-tap                  <span class="c">gum.rb:13</span></pre>
    </Plate>

    <div slot="margin" class="mt-8 lg:mt-0">
      <Kind />
    </div>
  </Section>

  <div class="crease"></div>

  <!-- ── 02 what it makes ──────────────────────────────────────────────── -->
  <Section
    id="makes"
    folio="02 — output"
    title="Five things, all of them files."
    note="lib/daily.jq — the numbers · prompts/daily.md — what the model may narrate"
  >
    <p class="mb-9 max-w-[62ch]">
      Markdown and JSON on disk, committed to a documentation repository you choose. Where a model
      is involved it writes prose only: <span class="font-mono text-[0.86em]">jq</span> computes every
      number and hands it over, because a model asked to both count and narrate does neither reliably.
    </p>

    <dl class="grid gap-px bg-ink/12 md:grid-cols-2">
      {
        makes.map((m) => (
          <div class="bg-paper-lit px-7 py-7">
            <dt
              class="mb-3 font-display text-[21px] font-semibold"
              style={`border-bottom:3px solid ${m.colour}; display:inline-block; padding-bottom:2px`}
            >
              {m.name}
            </dt>
            <dd class="text-[16.5px] leading-[1.55] text-ink-soft">{m.body}</dd>
          </div>
        ))
      }
      <div class="bg-paper-lit px-7 py-7 md:col-span-2">
        <dt
          class="mb-3 inline-block border-b-[3px] border-ink/50 pb-[2px] font-display text-[21px] font-semibold"
        >
          Runbooks and decisions
        </dt>
        <dd class="max-w-[70ch] text-[16.5px] leading-[1.55] text-ink-soft">
          Per repository: how to run it, which workflow ships it and on what trigger, where its
          alerts go, what it drags with it when it changes. Alongside them, a decision record mined
          from merged pull requests one week at a time — what was adopted, dropped or rejected,
          every bullet carrying its pull request.
        </dd>
      </div>
    </dl>

    <p class="mt-9 max-w-[62ch] border-l-[3px] border-vermilion pl-5 text-[18px] text-ink-soft">
      <strong class="font-semibold text-ink">A day is not a small week.</strong> Most of a day's work
      has not merged yet, so the digest reads four sources instead of one — and skips the day entirely
      when nothing landed. A digest that says “nothing happened” every weekend teaches people to stop
      opening it.
    </p>
  </Section>

  <div class="crease"></div>

  <!-- ── 03 one screen ─────────────────────────────────────────────────── -->
  <Section
    id="screen"
    folio="03 — the browser"
    title="One screen for all of it."
    note="lib/tui.sh — every pane is a subcommand, so orgami query prints exactly what the preview shows."
  >
    <p class="mb-2 max-w-[62ch]">
      <span class="font-mono text-[0.86em]">orgami view</span> is four tabs over the same data: the
      map, the repositories, the team's notes and the recaps. The list is on the left, the evidence
      is in the pane on the right, and the header says how stale the map is and whether this week
      has a recap yet.
    </p>

    <figure class="my-9">
      <div
        class="border-[6px] border-paper-lit bg-plate shadow-[0_1px_0_rgba(255,255,255,0.6),0_24px_44px_-26px_rgba(40,28,14,0.6)]"
      >
        <img
          src="/tui.png"
          alt="The orgami terminal browser: tabs for Map, Repos, Notes and Recaps, a list of repositories on the left, and a repository card on the right showing run commands, linked repositories, deploy targets and endpoints, each with the file and line it came from."
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
    </figure>

    <table class="w-full border-collapse text-[17px]">
      <tbody>
        {
          keys.map(([key, what]) => (
            <tr class="border-b border-ink/12">
              <td class="w-[1%] py-3 pr-8 align-top font-mono text-[13px] whitespace-nowrap text-vermilion">
                {key}
              </td>
              <td class="py-3 text-ink-soft">{what}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Section>

  <div class="crease"></div>

  <!-- ── 04 agents ─────────────────────────────────────────────────────── -->
  <Section
    id="agents"
    folio="04 — for agents"
    title="Your agent already has it."
    note="hooks/session-context.sh · lib/mcp.py · lib/agents.sh"
  >
    <p class="max-w-[62ch]">
      With the plugin installed there is nothing to run. Opening Claude Code in a mapped checkout
      puts the repository's stack, its exact run and test commands, the repositories it talks to and
      the team's notes into the session before you type. Outside a mapped repository it prints
      nothing at all.
    </p>

    <Plate caption="What lands in the session, before the first prompt.">
      <pre><span class="c">orgami — winit (winitapp), map from 2026-08-17</span>

<span class="b">WinIt-backend</span> <span class="c">— TypeScript, Agenda jobs, Express, Parse SDK, Parse Server</span>

  <span class="c">build:</span> tsc -p tsconfig.build.json
  <span class="c">test:</span>  cross-env NODE_ENV=test ... jest --silent --coverage test/*

<span class="c">linked repos:</span>
  calls <span class="a">-&gt;</span> Attorney-Portal
  changes-with <span class="a">&lt;-</span> Close-SMS-Report

<span class="t">team notes on this repo:</span>
- Parse Dashboard config lives in WinIt-ParseDashboard/index.js, not the fork …</pre>
    </Plate>

    <p class="max-w-[62ch]">
      Cursor reaches the same parity through its session hook. Anything that speaks MCP — opencode,
      Windsurf, Zed, Codex, VS Code — gets the map as tools. Anything that reads
      <span class="font-mono text-[0.86em]">AGENTS.md</span>{" "}can have the context written into the repository
      itself, as a marked block that is rewritten and never overwrites what you wrote around it.
    </p>
  </Section>

  <div class="crease"></div>

  <!-- ── 05 install ────────────────────────────────────────────────────── -->
  <Section
    id="install"
    folio="05 — install"
    title="A minute, and one command."
    note="CONTRIBUTING.md — testing it needs no organization, no token and no model."
  >
    <p class="mb-8 max-w-[62ch]">
      It installs what is missing, puts <span class="font-mono text-[0.86em]">orgami</span> on your PATH,
      and wires up Claude Code and Cursor if they are on the machine.
      <span class="font-mono text-[0.86em]">--dry-run</span> prints every step without touching anything.
    </p>

    <div class="grid max-w-[820px] gap-4">
      <Command command={install} />
      <Command command="gh auth login" />
      <Command command="orgami init" />
    </div>

    <p class="mt-8 max-w-[62ch]">
      In Claude Code,{" "}
      <span class="font-mono text-[0.86em]">/plugin marketplace add achevalier-dev/orgami</span>{" "}
      brings the skill, the commands and the session hook. A colleague who wants the map without scanning
      anything runs <span class="font-mono text-[0.86em]">orgami join</span>{" "}— it finds the repository that
      already holds one.
    </p>

    <p class="mt-8 max-w-[62ch] border-l-[3px] border-vermilion pl-5 text-[18px] text-ink-soft">
      <strong class="font-semibold text-ink">What it costs.</strong> Two model calls a week — the recap
      and the decision mining — plus one a weekday morning if you turn the digest on. Everything else is
      gh, git, jq and grep.
    </p>

    <p class="mt-8 max-w-[62ch]">
      The scan is pattern matching over committed files, so every organization it has never met is a
      gap in it. An organization it read wrong is the most useful bug report there is — there is a
      template for exactly that, and it needs no fix attached.
    </p>
  </Section>

  <footer class="border-t border-ink/15 bg-paper-shade/60">
    <div
      class="mx-auto flex max-w-[1180px] flex-wrap items-baseline justify-between gap-x-10 gap-y-4 px-6 py-12 font-mono text-[12px] text-ink-faint md:px-10"
    >
      <div class="flex flex-wrap gap-x-7 gap-y-2">
        <a href="https://github.com/achevalier-dev/orgami" class="no-underline hover:text-vermilion"
          >source</a
        >
        <a
          href="https://github.com/achevalier-dev/orgami#readme"
          class="no-underline hover:text-vermilion">documentation</a
        >
        <a
          href="https://github.com/achevalier-dev/orgami/labels/good%20first%20issue"
          class="no-underline hover:text-vermilion">good first issues</a
        >
        <a
          href="https://github.com/achevalier-dev/orgami/discussions"
          class="no-underline hover:text-vermilion">discussions</a
        >
      </div>
      <div>MIT · Antoine Chevalier · org + origami</div>
    </div>
  </footer>
</Base>
