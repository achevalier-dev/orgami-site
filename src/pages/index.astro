---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Command from "../components/Command.astro";
import Terminal from "../components/Terminal.astro";
import Demo from "../components/Demo.astro";
import Feature from "../components/Feature.astro";

const DEMO = "https://github.com/achevalier-dev/orgami-demo/blob/main";
const SRC = "https://github.com/achevalier-dev/orgami/blob/main";
const install =
  "curl -fsSL https://raw.githubusercontent.com/achevalier-dev/orgami/main/bootstrap.sh | bash";

const worksWith = [
  "Claude Code",
  "Cursor",
  "opencode",
  "Zed",
  "Codex",
  "VS Code",
  "any MCP client",
];

const steps = [
  {
    n: "01",
    title: "Point it at an org",
    body: "One command per client. It clones every repo shallow, reads what is committed, and writes a graph.",
    cmd: "orgami init acme --org acme-inc",
  },
  {
    n: "02",
    title: "It writes the files",
    body: "Architecture, a page per repo, runbooks, conventions, decisions — markdown and JSON, committed to a docs repo you choose.",
    cmd: "orgami scan && orgami doc",
  },
  {
    n: "03",
    title: "Your agent reads them",
    body: "Open Claude Code in a mapped checkout and the stack, commands, links and team notes are already in the session.",
    cmd: "orgami context",
  },
];

const faq = [
  {
    q: "What does it send anywhere?",
    a: "Nothing, until you publish. The map, the recaps and the notes are files in a directory you named. `orgami publish` and `orgami sync` are the only commands that push, they confirm first, and nothing else in the tool writes to a remote.",
  },
  {
    q: "How much does the model cost?",
    a: "Two calls a week — the recap and the decision mining — plus one a weekday morning if you turn the daily digest on, and none on a day where nothing landed. The map, the runbooks, the browser and every number in every report cost nothing.",
  },
  {
    q: "What can it not see?",
    a: "Anything not committed. Services wired together in a dashboard, a service mesh or a gateway leave no trace in a repository, so a missing edge means not found in committed configuration — never not connected. Which repos change together is correlation, counted from merged PRs, and it is labelled as such.",
  },
  {
    q: "Is it Claude-only?",
    a: "No. The plugin, the skill and the session hook are specific to Claude Code. Everything else is a CLI plus markdown on disk: Cursor gets the same context through its session hook, MCP clients get the map as tools, and anything that reads AGENTS.md can have it written into the repo.",
  },
  {
    q: "Who is it for?",
    a: "Anyone who has to be useful inside a codebase they did not write — freelancers holding four clients, a new hire on day one, or an agent that would otherwise guess.",
  },
];
---

<Base
  title="orgami"
  description="Map every repository a GitHub organization has — what it is, how to run it, what it talks to, where it deploys — and hand it to your coding agent before you type."
>
  <Nav />

  <main id="top">
    <!-- hero ------------------------------------------------------------->
    <section class="relative overflow-hidden">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="container relative pt-16 pb-16 lg:pt-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <span class="pill">
            <span class="h-[6px] w-[6px] rounded-full bg-brand"></span>
            v1.0.0 · open source · MIT
          </span>

          <h1 class="mt-6 text-[clamp(38px,5.6vw,60px)]">
            Know any GitHub org<br />before you touch its code.
          </h1>

          <p class="mt-5 max-w-[54ch] text-[18px] leading-[1.55] text-fg-2">
            orgami maps every repository — what it is, how to run it, what it talks to, where it
            deploys — recaps what merged each week, and hands all of it to your coding agent at
            session start. Every edge it draws names the file it came from.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#install" class="btn btn-primary">Install in 30 seconds</a>
            <a href="https://github.com/achevalier-dev/orgami-demo" class="btn btn-ghost"
              >See real output →</a
            >
          </div>

          <p class="mt-5 text-[13.5px] text-fg-3">
            macOS, Linux, WSL and Windows · bash, gh, jq · no daemon, no database, no account
          </p>
        </div>

        <Terminal title="orgami query hono">
          <pre><span class="a">▪ hono</span>  <span class="c">repo</span>

  <span class="c">language     </span>TypeScript
  <span class="c">description  </span>Web framework built on Web Standards

<span class="c">REFERENCED BY</span>
  cli                <span class="c">package.json:2</span>
  create-hono        <span class="c">package.json:2</span>
  examples           <span class="c">jsx-ssr/src/components/Layout.tsx:23</span>
  middleware         <span class="c">packages/zod-openapi/CHANGELOG.md:153</span>
  node-server        <span class="c">README.md:428</span>

<span class="c">USES</span>
  <span class="t">github-actions</span>     <span class="c">.github/workflows</span></pre>
        </Terminal>
      </div>

      <!-- what reads the map. true statements, no borrowed logos -->
      <div class="mt-16 border-t border-line pt-8">
        <p class="head-eyebrow">Feeds the context to</p>
        <div class="mt-4 flex flex-wrap gap-2.5">
          {worksWith.map((w) => <span class="chip">{w}</span>)}
        </div>
      </div>
      </div>
    </section>

    <!-- features ---------------------------------------------------------->
    <section class="container section">
      <p class="head-eyebrow">Output</p>
      <h2 class="head-title max-w-[22ch]">Four things it writes, all of them files.</h2>
      <p class="head-sub">
        Markdown and JSON on disk, committed to a documentation repository you choose. Where a
        model is involved it writes prose only — never a number.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <Feature
          kind="repo"
          title="A map with receipts"
          body="Every edge names the file it was read from. Open it, check it, or don't — but it is never a model's guess."
          href={`${DEMO}/graph.json`}
          linkLabel="graph.json from a real run"
        >
          <span class="text-fg-3">middleware</span> → hono<br />
          <span class="text-fg-3">packages/zod-openapi/CHANGELOG.md:153</span>
        </Feature>

        <Feature
          kind="host"
          title="Weekly recap"
          body="What the org merged, grouped by why it happened. jq counts, the model writes around numbers it was handed."
          href={`${SRC}/lib/stats.jq`}
          linkLabel="the program that counts"
        >
          "merged": 27,<br />
          "median_hours_to_merge": 33.6,<br />
          "merged_without_review": 7
        </Feature>

        <Feature
          kind="tool"
          title="Daily digest"
          body="What merged, what opened, what is waiting on someone, and commits with no pull request behind them."
          href={`${DEMO}/reports/daily/2026-08-17.md`}
          linkLabel="a digest it wrote"
        >
          <span class="text-fg-3">## Waiting on someone</span><br />
          hono#3295 — 728 days, opened by usualoma
        </Feature>

        <Feature
          kind="service"
          title="Team memory"
          body="Notes attach to the repo you were standing in and sync through git — screened for credentials and other clients first."
          href={`${SRC}/lib/notes.sh`}
          linkLabel="how the screening works"
        >
          <span class="text-fg-3">refusing to write this note:</span><br />
          - looks like a credential: AKIA…
        </Feature>
      </div>
    </section>

    <!-- product shot ------------------------------------------------------>
    <section class="border-y border-line bg-bg-sub">
      <div class="container section">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-5">
          <div>
            <p class="head-eyebrow">The browser</p>
            <h2 class="head-title max-w-[20ch]">The whole org in one screen.</h2>
          </div>
          <p class="max-w-[46ch] text-[15.5px] text-fg-2">
            Map, repositories, team notes and recaps in four tabs. The evidence sits in the preview
            pane; <span class="font-mono text-[0.9em]">ctrl-n</span> writes a note against whatever
            you are reading.
          </p>
        </div>

        <div class="relative">
          <div class="shot-glow" aria-hidden="true"></div>
          <div class="shot relative">
            <div class="flex items-center gap-2 border-b border-line-dark px-4 py-2.5">
              <span class="h-[9px] w-[9px] rounded-full bg-[#3a4049]"></span>
              <span class="h-[9px] w-[9px] rounded-full bg-[#3a4049]"></span>
              <span class="h-[9px] w-[9px] rounded-full bg-[#3a4049]"></span>
              <span class="ml-2 font-mono text-[11.5px] text-fg-invert-2">orgami view</span>
            </div>
            <img
              src="/tui.webp"
              width="1500"
              height="820"
              alt="The orgami terminal browser: tabs for Map, Repos, Notes and Recaps, a repository list on the left, and a card on the right showing run commands, linked repositories, deploy targets and endpoints with the file each came from."
              loading="lazy"
              decoding="async"
              class="block w-full"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- how it works ------------------------------------------------------>
    <section id="how" class="container section">
      <p class="head-eyebrow">How it works</p>
      <h2 class="head-title max-w-[24ch]">Three commands, then it stays current on its own.</h2>

      <div class="relative mt-12 grid gap-8 md:grid-cols-3 md:gap-6">
        <div
          class="absolute top-[13px] right-0 left-0 hidden h-px bg-line md:block"
          aria-hidden="true"></div>
        {
          steps.map((s) => (
            <div class="relative flex flex-col gap-3">
              <span class="relative flex h-[26px] w-[26px] items-center justify-center rounded-full border border-line bg-bg font-mono text-[11.5px] text-brand">
                {s.n}
              </span>
              <h3 class="mt-1 text-[19px]">{s.title}</h3>
              <p class="text-[15.5px] leading-[1.55] text-fg-2">{s.body}</p>
              <div class="mt-1">
                <Command command={s.cmd} />
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-8 max-w-[62ch] text-[15.5px] text-fg-2">
        A weekly timer runs the whole sequence and publishes it. A colleague who wants the map
        without scanning anything runs <span class="font-mono text-[0.9em]">orgami join</span> — it
        finds the repository that already holds one.
      </p>
    </section>

    <!-- proof -------------------------------------------------------------->
    <section id="proof" class="border-y border-line bg-bg-sub">
      <div class="container section">
        <p class="head-eyebrow">Proof, not promises</p>
        <h2 class="head-title max-w-[26ch]">One real run, published in full.</h2>
        <p class="head-sub">
          Everything on this page comes from a single run against the public{" "}
          <a class="link-brand" href="https://github.com/honojs">honojs</a> organization on 18 August
          2026. The output was not edited — it is a repository you can read right now.
        </p>

        <div class="mt-9 grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="card card-hover">
            <h3 class="text-[17px]">What the run produced</h3>
            <dl class="stat mt-5 grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-3">
              <div><dd class="stat-value">14</dd><dt class="stat-label">repositories</dt></div>
              <div><dd class="stat-value">4s</dd><dt class="stat-label">to scan them</dt></div>
              <div><dd class="stat-value">17/49</dd><dt class="stat-label">nodes / edges</dt></div>
              <div><dd class="stat-value">35</dd><dt class="stat-label">files written</dt></div>
              <div><dd class="stat-value">1</dd><dt class="stat-label">model call</dt></div>
              <div><dd class="stat-value">0</dd><dt class="stat-label">edited by hand</dt></div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[14px]">
              <a class="link-brand" href={`${DEMO}/ARCHITECTURE.md`}>ARCHITECTURE.md</a>
              <a class="link-brand" href={`${DEMO}/repos/honox.md`}>repos/honox.md</a>
              <a class="link-brand" href={`${DEMO}/runbooks/hono.md`}>runbooks/hono.md</a>
              <a class="link-brand" href={`${DEMO}/reports/daily/2026-08-17.md`}>a daily digest</a>
              <a class="link-brand" href={`${DEMO}/graph.json`}>graph.json</a>
            </div>
          </div>

          <div class="card card-hover">
            <h3 class="text-[17px]">How much of it carries a file</h3>
            <p class="mt-2 text-[14px] text-fg-2">
              Of the 49 edges in that graph, this is exactly what each kind can cite.
            </p>
            <table class="mt-4 w-full border-collapse font-mono text-[13.5px]">
              <tbody>
                <tr class="border-b border-line">
                  <td class="py-2">references</td><td class="py-2 text-fg-3">26</td>
                  <td class="py-2 text-right">file:line</td>
                </tr>
                <tr class="border-b border-line">
                  <td class="py-2">uses</td><td class="py-2 text-fg-3">11</td>
                  <td class="py-2 text-right">file</td>
                </tr>
                <tr>
                  <td class="py-2">written-in</td><td class="py-2 text-fg-3">12</td>
                  <td class="py-2 text-right text-fg-3">none</td>
                </tr>
              </tbody>
            </table>
            <p class="mt-3 text-[13.5px] text-fg-3">
              The last row is GitHub's language field. No file states it, so the map cites none —
              and says so rather than implying the three are equal.
            </p>
          </div>
        </div>

        <div class="mt-8">
          <Demo caption="orgami brief, orgami query, the browser and the week's numbers — same organization, same run." />
        </div>
      </div>
    </section>

    <!-- limits ------------------------------------------------------------>
    <section id="limits" class="container section">
      <p class="head-eyebrow">Limits</p>
      <h2 class="head-title max-w-[24ch]">What it cannot do.</h2>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <div class="card card-hover">
          <h3 class="text-[17px]">Runtime wiring is invisible</h3>
          <p class="mt-2 text-[15px] text-fg-2">
            Services joined by an environment variable set in a dashboard, a service mesh or a
            gateway leave nothing in a repository.
          </p>
        </div>
        <div class="card card-hover">
          <h3 class="text-[17px]">Coupling is correlation</h3>
          <p class="mt-2 text-[15px] text-fg-2">
            Which repositories change together is counted from merged pull requests. Useful blast
            radius, not a dependency, and labelled that way.
          </p>
        </div>
        <div class="card card-hover">
          <h3 class="text-[17px]">The scan is pattern matching</h3>
          <p class="mt-2 text-[15px] text-fg-2">
            Every stack it has never met is a gap in it. An unrecognised repository gets an empty
            page rather than a guessed one.
          </p>
        </div>
        <div class="card card-hover">
          <h3 class="text-[17px]">The model never counts</h3>
          <p class="mt-2 text-[15px] text-fg-2">
            <a class="link-brand" href={`${SRC}/lib/stats.jq`}>jq</a> computes every figure and hands
            them over. Links are generated afterwards, from references that already exist.
          </p>
        </div>
      </div>
    </section>

    <!-- install ------------------------------------------------------------>
    <section id="install" class="relative overflow-hidden border-t border-line bg-bg-dark">
      <div class="dot-bg" aria-hidden="true"></div>
      <div class="container section relative text-fg-invert">
        <h2 class="max-w-[20ch] text-[clamp(30px,4vw,44px)]">Map your first org in a minute.</h2>
        <p class="mt-4 max-w-[58ch] text-[17px] text-fg-invert-2">
          The installer adds what is missing, puts orgami on your PATH, and wires up Claude Code and
          Cursor if they are on the machine. <span class="font-mono text-[0.9em]">--dry-run</span> prints
          every step without touching anything.
        </p>

        <div class="mt-8 grid max-w-[820px] gap-3">
          <Command command={install} dark />
          <Command command="gh auth login" dark />
          <Command command="orgami init" dark />
        </div>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-[14px] text-fg-invert-2">
          <a class="text-[#7fb2ff] hover:underline" href="https://github.com/achevalier-dev/orgami"
            >Source on GitHub</a
          >
          <a
            class="text-[#7fb2ff] hover:underline"
            href="https://github.com/achevalier-dev/orgami/blob/main/CONTRIBUTING.md">Contributing</a
          >
          <a
            class="text-[#7fb2ff] hover:underline"
            href="https://github.com/achevalier-dev/orgami/labels/good%20first%20issue"
            >Good first issues</a
          >
        </div>
      </div>
    </section>

    <!-- faq ----------------------------------------------------------------->
    <section id="faq" class="container section max-w-[820px]">
      <p class="head-eyebrow">FAQ</p>
      <h2 class="head-title">Questions worth asking first.</h2>

      <div class="mt-8 divide-y divide-line border-y border-line">
        {
          faq.map((item) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-medium">
                {item.q}
                <span class="text-fg-3 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 max-w-[70ch] text-[15.5px] leading-[1.6] text-fg-2">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-x-8 gap-y-4 px-5 py-10 text-[13.5px] text-fg-3 sm:px-8"
      >
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="https://github.com/achevalier-dev/orgami" class="hover:text-fg">Source</a>
          <a href="https://github.com/achevalier-dev/orgami-demo" class="hover:text-fg"
            >The run on this page</a
          >
          <a href="https://github.com/achevalier-dev/orgami/discussions" class="hover:text-fg"
            >Discussions</a
          >
          <a
            href="https://github.com/achevalier-dev/orgami/releases/tag/v1.0.0"
            class="hover:text-fg">v1.0.0</a
          >
        </div>
        <p>MIT · Antoine Chevalier · org + origami</p>
      </div>
    </footer>
  </main>
</Base>
