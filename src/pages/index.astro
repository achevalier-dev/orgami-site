---
import Base from "../layouts/Base.astro";
import Command from "../components/Command.astro";
import Demo from "../components/Demo.astro";
import Row from "../components/Row.astro";

const DEMO = "https://github.com/achevalier-dev/orgami-demo/blob/main";
const SRC = "https://github.com/achevalier-dev/orgami/blob/main";

const install =
  "curl -fsSL https://raw.githubusercontent.com/achevalier-dev/orgami/main/bootstrap.sh | bash";

// Measured on the run that produced github.com/achevalier-dev/orgami-demo.
const run = [
  ["organization", "github.com/honojs, public"],
  ["repositories read", "14"],
  ["scan time", "4s over cached clones"],
  ["graph", "17 nodes, 49 edges"],
  ["model calls", "1, for the daily digest"],
  ["output", "35 files, all of it public"],
];

const coverage = [
  ["references", "26", "file:line", "A literal string in a committed file — an import, a manifest entry, a URL."],
  ["uses", "11", "file", "The file's existence is the evidence: a Dockerfile, a workflow directory."],
  ["written-in", "12", "none", "GitHub's own language field. No file states it, so no file is cited."],
];

const limits = [
  [
    "Runtime wiring is invisible.",
    "Services joined by an environment variable set in a dashboard, a service mesh, or a shared gateway leave nothing in a repository. A missing edge means not found in committed configuration — it never means not connected.",
  ],
  [
    "Which repositories change together is correlation.",
    "It is counted from same-day and same-week co-occurrence in merged pull requests, with bots excluded. It is a useful blast radius and it is not a dependency.",
  ],
  [
    "Endpoints come from committed source.",
    "A route defined at runtime is not found, and until recently routes declared inside test files were counted as real ones — reported by a contributor, fixed in the open.",
  ],
  [
    "The scan is pattern matching.",
    "Every organization it has never met is a gap in it. A stack it does not recognize produces a repository page with an empty stack, not a guess at one.",
  ],
  [
    "The model never counts.",
    "jq computes every figure in every report and hands them over. The model writes sentences around numbers it was given, and its links are generated afterwards from references that already exist.",
  ],
];
---

<Base
  title="orgami"
  description="Map every repository a GitHub organization has, with the file:line behind every edge. Read the full unedited output of a real run before you install anything."
>
  <main class="mx-auto max-w-[1080px] px-6 py-14 md:px-10 lg:py-20">
    <!-- masthead ---------------------------------------------------------->
    <header>
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <h1 class="text-[26px] tracking-[-0.02em]">orgami</h1>
        <p class="label">v1.0.0 · MIT · bash</p>
      </div>

      <p class="mt-6 max-w-[68ch] text-[17px] leading-[1.55]">
        Reads what a GitHub organization has committed — what each repository is, how to run it,
        what it talks to, where it deploys — and writes it to plain files your coding agent reads
        before you type. Every edge it draws names the file it came from.
      </p>

      <div class="mt-8 max-w-[760px]">
        <Command command={install} />
      </div>

      <!-- provenance: the numbers on this page belong to one real run -->
      <section class="mt-10 border border-hair-2 bg-sheet-2">
        <p class="border-b border-hair px-5 py-3 text-[12.5px] text-ink-2">
          Everything below is from one run against a public organization on 18 August 2026. The
          output was not edited, and it is published in full.
        </p>
        <dl class="grid grid-cols-1 gap-px bg-hair sm:grid-cols-2 lg:grid-cols-3">
          {
            run.map(([k, v]) => (
              <div class="bg-sheet-2 px-5 py-3">
                <dt class="label">{k}</dt>
                <dd class="text-[14px] text-ink">{v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="border-t border-hair px-5 py-3 text-[12.5px]">
          <a href="https://github.com/achevalier-dev/orgami-demo" rel="noopener"
            >Read the whole thing →</a
          >
        </p>
      </section>
    </header>

    <!-- the ledger --------------------------------------------------------->
    <section class="mt-16">
      <h2 class="label mb-1">Claims, and what proves them</h2>

      <Row
        claim="Every reference between repositories names the file and line it was read from, so you can open it."
        href={`${DEMO}/repos/hono.md`}
        receipt="orgami-demo/repos/hono.md"
      >
        <div class="plate">
          <pre><span class="a">▪ hono</span>  <span class="c">repo</span>

<span class="c">REFERENCED BY</span>
  cli                <span class="c">package.json:2</span>
  create-hono        <span class="c">package.json:2</span>
  examples           <span class="c">jsx-ssr/src/components/Layout.tsx:23</span>
  middleware         <span class="c">packages/zod-openapi/CHANGELOG.md:153</span>
  node-server        <span class="c">README.md:428</span></pre>
        </div>
      </Row>

      <Row
        claim="Not every edge can carry a line, and the map says which kind is which rather than implying they are equal."
        href={`${DEMO}/graph.json`}
        receipt="orgami-demo/graph.json"
      >
        <table class="data">
          <thead>
            <tr><th>edge</th><th>count</th><th>evidence</th><th>why</th></tr>
          </thead>
          <tbody>
            {
              coverage.map(([kind, n, ev, why]) => (
                <tr>
                  <td>{kind}</td>
                  <td>{n}</td>
                  <td class="whitespace-nowrap">{ev}</td>
                  <td class="text-[12.5px]">{why}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Row>

      <Row
        claim="The repository page an agent reads is generated, not written: stack, the exact commands, what it talks to, what it serves, and where it ships."
        href={`${DEMO}/repos/honox.md`}
        receipt="orgami-demo/repos/honox.md"
      >
        <div class="plate">
          <pre><span class="b">honox</span> <span class="c">— TypeScript · pushed 3w ago</span>

<span class="c">RUN IT</span>
  test              <span class="c">bun typecheck &amp;&amp; bun test:unit &amp;&amp; bun test:e2e</span>
  build             <span class="c">tsdown &amp;&amp; publint</span>

<span class="c">TALKS TO</span>
  → hono            <span class="c">package.json:96</span>
  ← honox-website   <span class="c">package.json:15</span>

<span class="c">SHIPS</span>
  release on push   <span class="c">.github/workflows/release.yml</span></pre>
        </div>
      </Row>

      <Row
        claim="The weekly recap and the daily digest are counted by jq and narrated by a model that is handed the numbers, never asked for them."
        href={`${DEMO}/reports/daily/2026-08-17.md`}
        receipt="orgami-demo/reports/daily/2026-08-17.md"
      >
        <div class="plate">
          <pre><span class="c"># honojs · Monday 17 August 2026</span>

PatternRouter and LinearRouter matched wildcard routes too
loosely — /assets* matched /asset. <span class="a">hono#5252</span> fixes the two
overmatching routers, <span class="a">hono#5236</span> fixes TrieRouter.

<span class="c">## Waiting on someone</span>
  <span class="a">hono#3295</span>  <span class="c">728 days, opened by usualoma</span>

<span class="c">8 merged · 12 opened · 3 commits · 2 repos · 3 people</span></pre>
        </div>
        <p slot="detail" class="mt-3 text-[12.5px] text-ink-3">
          The numbers in that last line come from <a href={`${SRC}/lib/daily.jq`}>lib/daily.jq</a>.
          The prose comes from <a href={`${SRC}/prompts/daily.md`}>prompts/daily.md</a>, which is
          told the figures and forbidden to compute its own.
        </p>
      </Row>

      <Row
        claim="One command prints what an agent is handed, so you can read it before an agent does."
        href={`${DEMO}/ARCHITECTURE.md`}
        receipt="orgami-demo/ARCHITECTURE.md"
      >
        <Demo caption="orgami brief, orgami query, the browser, and the week's numbers — recorded against the same organization." />
      </Row>

      <Row
        claim="The whole map, the repositories, the team's notes and the recaps browse in one terminal screen."
        href={`${SRC}/lib/tui.sh`}
        receipt="orgami/lib/tui.sh"
      >
        <img
          src="/tui.png"
          alt="The orgami terminal browser: tabs for Map, Repos, Notes and Recaps, a repository list on the left, and a card on the right showing run commands, linked repositories, deploy targets and endpoints with the file each came from."
          loading="lazy"
          decoding="async"
          class="block h-auto w-full border border-hair-2"
        />
      </Row>
    </section>

    <!-- limits ------------------------------------------------------------->
    <section class="mt-16">
      <h2 class="label mb-1">What it cannot do</h2>
      <div class="border-t border-hair">
        {
          limits.map(([title, body]) => (
            <div class="grid gap-2 border-b border-hair py-5 lg:grid-cols-[minmax(0,47fr)_minmax(0,53fr)] lg:gap-10">
              <p class="text-[15px] text-ink">{title}</p>
              <p class="text-[13.5px] text-ink-2">{body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- reproduce ---------------------------------------------------------->
    <section class="mt-16">
      <h2 class="label mb-1">Check it yourself</h2>
      <p class="mt-3 max-w-[68ch] text-[14px] text-ink-2">
        Point it at any public organization your GitHub token can read. Nothing is written outside
        the directory you name, nothing is pushed anywhere, and the first three commands cost no
        model call at all.
      </p>

      <div class="mt-6 grid max-w-[820px] gap-3">
        <Command command="export ORGAMI_HOME=/tmp/orgami-check" />
        <Command command="orgami init check --org honojs" />
        <Command command="orgami scan && orgami doc" />
        <Command command="orgami query hono" />
      </div>

      <p class="mt-6 max-w-[68ch] text-[13.5px] text-ink-2">
        You should get 14 repositories, a graph of 17 nodes and 49 edges, and the same evidence
        lines shown above — the organization moves, so the counts move with it. The tool's own test
        suite needs no organization and no token:{" "}
        <a href={`${SRC}/script/check`}>script/check</a> runs shellcheck, the shell syntax pass and
        both report programs against fixture data.
      </p>
    </section>

    <!-- cost --------------------------------------------------------------->
    <section class="mt-16 border border-hair-2 bg-sheet-2 p-6">
      <h2 class="label">What it costs to run</h2>
      <p class="mt-3 max-w-[68ch] text-[14px] text-ink-2">
        Two model calls a week — the recap and the decision mining — plus one a weekday morning if
        you turn the daily digest on, and none on a day where nothing landed. Everything else is{" "}
        <span class="text-ink">gh</span>, <span class="text-ink">git</span>,{" "}
        <span class="text-ink">jq</span> and <span class="text-ink">grep</span>. The map, the
        runbooks, the browser and every number in every report are free.
      </p>
    </section>

    <footer class="mt-16 border-t border-hair pt-8 text-[12.5px] text-ink-3">
      <div class="flex flex-wrap gap-x-7 gap-y-2">
        <a href="https://github.com/achevalier-dev/orgami">source</a>
        <a href="https://github.com/achevalier-dev/orgami-demo">the run on this page</a>
        <a href="https://github.com/achevalier-dev/orgami/blob/main/CONTRIBUTING.md">contributing</a>
        <a href="https://github.com/achevalier-dev/orgami/issues">issues</a>
        <a href="https://github.com/achevalier-dev/orgami/releases/tag/v1.0.0">v1.0.0</a>
      </div>
      <p class="mt-4">MIT · Antoine Chevalier · org + origami</p>
    </footer>
  </main>
</Base>
