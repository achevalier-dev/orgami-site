---
// The legend. These four colours mean exactly what they mean inside the tool.
const kinds = [
  { name: "repository", cls: "bg-k-repo", glyph: "▪" },
  { name: "host", cls: "bg-k-host", glyph: "◆" },
  { name: "tool", cls: "bg-k-tool", glyph: "◈" },
  { name: "service", cls: "bg-k-service", glyph: "▣" },
];
---

<ul class="flex flex-wrap items-center gap-x-7 gap-y-2 font-mono text-[11.5px] text-ink-faint">
  {
    kinds.map((k) => (
      <li class="flex items-center gap-2">
        <span class:list={["inline-block h-3 w-3", k.cls]} aria-hidden="true" />
        {k.name}
      </li>
    ))
  }
</ul>
