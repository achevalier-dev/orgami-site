---
// One line of the ledger: what is claimed, and the file that proves it.
interface Props {
  claim: string;
  href?: string;
  receipt?: string;
}
const { claim, href, receipt } = Astro.props;
---

<div class="row">
  <div>
    <p class="text-[15px] leading-[1.6] text-ink">{claim}</p>
    <slot name="detail" />
  </div>
  <div class="min-w-0">
    <slot />
    {
      href && receipt && (
        <p class="mt-2.5">
          <a class="receipt" href={href} rel="noopener">
            {receipt}
          </a>
        </p>
      )
    }
  </div>
</div>
