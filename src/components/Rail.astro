---
// The crease: one tick per section, doubling as navigation. org + origami —
// a flat sheet folded into a shape you can see.
const sections = [
  { id: "top", label: "orgami" },
  { id: "evidence", label: "Evidence" },
  { id: "makes", label: "What it makes" },
  { id: "screen", label: "One screen" },
  { id: "agents", label: "For agents" },
  { id: "install", label: "Install" },
];
---

<nav
  class="fixed inset-y-0 left-0 z-10 hidden w-[148px] flex-col gap-3.5 py-8 pl-6 xl:flex"
  aria-label="Sections"
>
  <span
    class="absolute inset-y-0 right-0 w-px bg-gradient-to-b from-transparent via-rule to-transparent"
    aria-hidden="true"></span>

  {
    sections.map((s) => (
      <a
        href={`#${s.id}`}
        data-rail-link={s.id}
        class="group relative pr-[18px] text-right font-mono text-[10.5px] uppercase tracking-[0.1em] text-faint no-underline transition-colors hover:text-accent aria-[current=true]:text-accent"
      >
        {s.label}
        <span
          class="absolute top-1/2 -right-px h-px w-[7px] bg-rule transition-all group-hover:w-[15px] group-hover:bg-accent group-aria-[current=true]:w-[15px] group-aria-[current=true]:bg-accent"
          aria-hidden="true"
        />
      </a>
    ))
  }

  <button
    id="theme-toggle"
    type="button"
    class="mt-auto mr-[18px] cursor-pointer border border-rule bg-transparent px-2 py-1 text-right font-mono text-[10px] uppercase tracking-[0.12em] text-muted transition-colors hover:border-accent hover:text-accent"
  >
    Theme
  </button>
</nav>

<script>
  // Mark the section actually on screen.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]"),
  );
  const seen = new Map<string, number>();

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => seen.set(e.target.id, e.intersectionRatio));
      let best = "";
      let ratio = 0;
      seen.forEach((r, id) => {
        if (r > ratio) {
          ratio = r;
          best = id;
        }
      });
      links.forEach((a) =>
        a.setAttribute("aria-current", a.dataset.railLink === best ? "true" : "false"),
      );
    },
    { threshold: [0.02, 0.25, 0.6] },
  );

  links.forEach((a) => {
    const section = document.getElementById(a.dataset.railLink ?? "");
    if (section) observer.observe(section);
  });

  // Light and dark, remembered. No preference stored means the reader's own
  // system setting keeps deciding.
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");

  toggle?.addEventListener("click", () => {
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.getAttribute("data-theme") ?? (systemDark ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try {
      localStorage.setItem("orgami-theme", next);
    } catch (e) {}
  });
</script>
