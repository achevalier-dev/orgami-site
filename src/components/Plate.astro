---
// Terminal output, printed and laid on the sheet.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="my-9">
  <div class="plate">
    <slot />
  </div>
  {
    caption && (
      <figcaption class="mt-3 font-mono text-[11.5px] text-ink-faint">
        <span class="rule-mark">—</span> {caption}
      </figcaption>
    )
  }
</figure>
