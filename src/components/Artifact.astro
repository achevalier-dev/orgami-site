---
// One of the five things orgami writes. The dot carries the node-kind colour
// the map itself uses, so the colour means something.
interface Props {
  title: string;
  kind: "repo" | "host" | "tool" | "service" | "muted";
  wide?: boolean;
}
const { title, kind, wide = false } = Astro.props;

const dot = {
  repo: "bg-repo",
  host: "bg-host",
  tool: "bg-tool",
  service: "bg-service",
  muted: "bg-muted",
}[kind];
---

<div class:list={["bg-surface px-6 py-[26px]", wide && "md:col-span-2"]}>
  <p class="mb-3 flex items-center gap-2 font-mono text-[10.5px] tracking-[0.17em] uppercase">
    <span class:list={["h-[7px] w-[7px] flex-none rounded-full", dot]} aria-hidden="true"></span>
    {title}
  </p>
  <p class="text-[15.5px] text-ink-soft"><slot /></p>
</div>
