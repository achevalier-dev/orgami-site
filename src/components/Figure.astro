---
interface Props {
  src: string;
  alt: string;
  caption: string;
  loading?: "eager" | "lazy";
}
const { src, alt, caption, loading = "lazy" } = Astro.props;
---

<figure class="mt-[34px] overflow-hidden rounded-[4px] border border-rule bg-term">
  <img src={src} alt={alt} loading={loading} decoding="async" class="block h-auto w-full" />
  <figcaption
    class="border-t border-rule bg-surface px-3.5 py-2.5 font-mono text-[11px] leading-relaxed text-faint"
  >
    {caption}
  </figcaption>
</figure>
