---
// A framed terminal, the way the tool actually prints.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="overflow-hidden rounded-[14px] border border-line-dark bg-bg-dark shadow-[0_24px_60px_-30px_rgba(11,13,16,0.6)]">
  <div class="flex items-center gap-2 border-b border-line-dark px-4 py-2.5">
    <span class="h-[9px] w-[9px] rounded-full bg-[#3a4049]"></span>
    <span class="h-[9px] w-[9px] rounded-full bg-[#3a4049]"></span>
    <span class="h-[9px] w-[9px] rounded-full bg-[#3a4049]"></span>
    <span class="ml-2 font-mono text-[11.5px] text-fg-invert-2">{title}</span>
  </div>
  <div class="term !rounded-none">
    <slot />
  </div>
</div>
