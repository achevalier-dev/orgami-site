---
// The one orchestrated moment: a flat sheet of repository names folds once, on
// load, and settles. Mountain and valley alternate, so the light lands on
// opposite faces — that is the whole of the name in one gesture.
//
// Real repository names from a scan of the public honojs organization.
const strips = [
  { names: ["hono", "middleware", "node-server"], kind: "repo" },
  { names: ["honox", "vite-plugins", "cli"], kind: "repo" },
  { names: ["github-actions", "vercel", "docker"], kind: "tool" },
  { names: ["hono.dev", "api.honojs.dev"], kind: "host" },
];
---

<div class="fold" aria-hidden="true">
  <div class="fold-sheet">
    {
      strips.map((strip, i) => (
        <div class="fold-strip" style={`--i:${i}`} data-kind={strip.kind}>
          <div class="fold-strip-inner">
            {strip.names.map((n) => (
              <span>{n}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .fold {
    perspective: 1400px;
    perspective-origin: 50% 30%;
    margin: 0 0 8px;
  }

  .fold-sheet {
    transform-style: preserve-3d;
    display: flex;
    flex-direction: column;
    transform: rotateX(14deg);
    filter: drop-shadow(0 26px 30px rgba(60, 44, 22, 0.28));
  }

  .fold-strip {
    transform-style: preserve-3d;
    transform-origin: top center;
    background: linear-gradient(
      to bottom,
      var(--paper-lit),
      var(--paper) 60%,
      var(--paper-shade)
    );
    border-top: 1px solid rgba(255, 255, 255, 0.75);
    border-bottom: 1px solid rgba(120, 100, 70, 0.22);
    box-shadow: 0 6px 12px -8px rgba(60, 44, 22, 0.5);
    animation: fold-settle 1500ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 110ms + 180ms);
  }

  /* valley folds catch less light than mountain folds */
  .fold-strip:nth-child(even) {
    background: linear-gradient(
      to bottom,
      var(--paper-shade),
      var(--paper-deep) 70%,
      var(--paper-shade)
    );
  }

  .fold-strip-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    padding: 15px 24px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .fold-strip[data-kind="repo"] .fold-strip-inner { color: var(--k-repo); }
  .fold-strip[data-kind="tool"] .fold-strip-inner { color: var(--k-tool); }
  .fold-strip[data-kind="host"] .fold-strip-inner { color: var(--k-host); }

  @keyframes fold-settle {
    from {
      transform: rotateX(-78deg);
      filter: brightness(1.28);
    }
    to {
      transform: rotateX(0deg);
      filter: brightness(1);
    }
  }

  /* A reader who asked for less motion gets the sheet already folded. */
  @media (prefers-reduced-motion: reduce) {
    .fold-strip {
      animation: none;
      transform: none;
    }
  }
</style>
