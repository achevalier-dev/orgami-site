---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="my-10">
  <div
    class="border-[6px] border-paper-lit bg-plate shadow-[0_1px_0_rgba(255,255,255,0.6),0_24px_44px_-26px_rgba(40,28,14,0.6),0_2px_8px_rgba(40,28,14,0.14)]"
  >
    <video
      id="demo"
      class="block h-auto w-full"
      src="/demo.mp4"
      poster="/demo-poster.webp"
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="A terminal session: orgami prints a repository's stack and commands, then one node and every edge that named it with the file and line each came from, then the map browsing in a terminal UI, then the week's numbers."
    ></video>
  </div>
  <figcaption
    class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11.5px] text-ink-faint"
  >
    <span class="rule-mark">—</span>
    <span>{caption}</span>
    <button
      type="button"
      id="demo-toggle"
      class="ml-auto cursor-pointer border border-ink/20 px-2 py-[3px] font-mono text-[10px] tracking-[0.14em] uppercase transition-colors hover:border-vermilion hover:text-vermilion"
      hidden>Play</button
    >
  </figcaption>
</figure>

<script>
  const video = document.getElementById("demo") as HTMLVideoElement | null;
  const toggle = document.getElementById("demo-toggle") as HTMLButtonElement | null;
  if (video && toggle) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const label = () => (toggle.textContent = video.paused ? "Play" : "Pause");
    if (!still) {
      video.autoplay = true;
      video.play().catch(() => {});
    }
    toggle.hidden = false;
    label();
    toggle.addEventListener("click", () => {
      video.paused ? video.play() : video.pause();
      label();
    });
    video.addEventListener("play", label);
    video.addEventListener("pause", label);
  }
</script>
