---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="my-10">
  <div class="relative">
    <div class="shot-glow" aria-hidden="true"></div>
  <div class="shot relative">
    <video
      id="demo"
      class="block h-auto w-full"
      src="/demo.mp4"
      poster="/demo-poster.webp"
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="A terminal session: orgami prints a repository's stack and commands, then one node and every edge that named it with the file and line each came from, then the map browsing in a terminal UI, then the week's numbers."
    ></video>
  </div>
  </div>
  <figcaption
    class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11.5px] text-fg-3"
  >
    <span>{caption}</span>
    <button
      type="button"
      id="demo-toggle"
      class="ml-auto cursor-pointer rounded-[6px] border border-line-2 px-2.5 py-1 font-mono text-[11px] text-fg-3 transition-colors hover:border-brand hover:text-brand"
      hidden>Play</button
    >
  </figcaption>
</figure>

<script>
  const video = document.getElementById("demo") as HTMLVideoElement | null;
  const toggle = document.getElementById("demo-toggle") as HTMLButtonElement | null;
  if (video && toggle) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const label = () => (toggle.textContent = video.paused ? "Play" : "Pause");
    if (!still) {
      video.autoplay = true;
      video.play().catch(() => {});
    }
    toggle.hidden = false;
    label();
    toggle.addEventListener("click", () => {
      video.paused ? video.play() : video.pause();
      label();
    });
    video.addEventListener("play", label);
    video.addEventListener("pause", label);
  }
</script>
